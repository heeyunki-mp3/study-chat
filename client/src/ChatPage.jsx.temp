import "@chatscope/chat-ui-kit-styles/dist/default/styles.min.css";
import {
  MainContainer,
  ChatContainer,
  MessageList,
  Message,
  MessageInput,
  TypingIndicator,
} from "@chatscope/chat-ui-kit-react";
import { useEffect, useMemo, useState } from "react";
import { io } from "socket.io-client";

export default function ChatPage() {
  console.log("chat page loaded");
  const socket = useMemo(
    () =>
      io("http://localhost:3001", {
        autoConnect: false,
        transports: ["polling"], // ✅ polling only
        withCredentials: true,
      }),
    []
  );
  const [messages, setMessages] = useState([]);
  const [typing, setTyping] = useState({});
  const [session, setSession] = useState(null);

  useEffect(() => {
    console.log("Setting up socket handlers...");
  
    socket.on("connect", () => console.log("connected", socket.id));
    socket.on("connect_error", (err) => console.log("connect_error", err));
    socket.on("error", (err) => console.log("socket error", err));
  
    socket.on("session", (s) => setSession(s));
  
    socket.on("seed", (seedMsgs) => {
      setMessages((prev) => [
        ...prev,
        ...seedMsgs.map((m) => ({
          sender: m.name,
          message: m.text,
          direction: "incoming",
        })),
      ]);
    });
  
    socket.on("message", (m) => {
      setMessages((prev) => [
        ...prev,
        {
          sender: m.name,
          message: m.text,
          direction: m.name === "You" ? "outgoing" : "incoming",
        },
      ]);
    });
  
    socket.on("typing", ({ who, isTyping }) => {
      setTyping((prev) => ({ ...prev, [who]: isTyping }));
    });
  
    // 🔴 IMPORTANT: connect AFTER handlers are attached
    socket.connect();
  
    return () => {
      console.log("Cleaning up socket");
      socket.disconnect();
    };
  }, [socket]);

  const typingText = Object.entries(typing)
    .filter(([, v]) => v)
    .map(([k]) => k)
    .join(", ");

  function onSend(text) {
    socket.emit("human_message", { text });
  }

  function goLogin() {
    socket.emit("end");
    // store sessionId so login page can log choice
    if (session?.sessionId)
      localStorage.setItem("sessionId", session.sessionId);
    window.location.href = "/login";
  }

  return (
    <div style={{ height: "100vh", padding: 16 }}>
      <div style={{ marginBottom: 8, color: "#666" }}>
        {session
          ? `Condition: ${session.condition} (prototype only; hide later)`
          : "Connecting..."}
      </div>

      <div style={{ height: "75vh" }}>
        <MainContainer>
          <ChatContainer>
            <MessageList
              typingIndicator={
                typingText ? (
                  <TypingIndicator content={`${typingText} typing…`} />
                ) : null
              }
            >
              {messages.map((m, i) => (
                <Message
                  key={i}
                  model={{
                    message: m.message,
                    sentTime: "just now",
                    sender: m.sender,
                    direction: m.direction,
                    position: "single",
                  }}
                />
              ))}
            </MessageList>
            <MessageInput placeholder="Type..." onSend={onSend} />
          </ChatContainer>
        </MainContainer>
      </div>

      <div
        style={{
          marginTop: 12,
          display: "flex",
          justifyContent: "space-between",
        }}
      >
        <div style={{ color: "#666" }}>
          Discuss a few technologies. When done, proceed to compensation login.
        </div>
        <button onClick={goLogin} style={{ padding: "10px 14px" }}>
          Proceed to Login
        </button>
      </div>
    </div>
  );
}
